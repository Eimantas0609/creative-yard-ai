# Backend Environment Variables (Supabase Edge Functions)
# NEVER expose these variables to the frontend!
# Set via Lovable Cloud dashboard: Settings → Secrets

# OpenAI Configuration (for AI features in Phase 2)
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Supabase Admin Access
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Email Configuration (Optional - for contact form notifications)
RESEND_API_KEY=re_...
MAIL_FROM="Creative Yard <hello@example.com>"
MAIL_TO=owner@example.com

# CORS Configuration (Optional - for production)
SITE_ORIGIN=https://your-domain.com

# How to set these secrets:
# 1. Open Lovable Cloud dashboard
# 2. Navigate to Settings → Secrets
# 3. Add each secret individually using the UI
#
# Or via Supabase CLI (if connected):
# supabase secrets set OPENAI_API_KEY=sk-...
# supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
